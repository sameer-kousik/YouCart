{
    "manifest_version": 3,
    "name": "YouCart - YouTube to Kroger Cart",
    "version": "0.1.0",
    "description": "Analyze YouTube recipe videos and add ingredients to your Kroger cart.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "*://*.googleusercontent.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/watch?v=*"],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["oauth_callback.html"],
            "matches": ["<all_urls>"]
        }
    ]
}
